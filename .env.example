SPEECH_KEY=your_azure_subscription_key_here
SPEECH_REGION=eastus
ASR_LANGUAGE=zh-CN
DEEPSEEK_API_KEY=your_deepseek_api_key_here
TEXT_MODEL=deepseek-chat
OPENAI_API_KEY=your_openai_api_key_here
VISION_MODEL=gemini-2.5-flash-lite

SCREENSHOT_HOTKEY=alt+p
# ASR_INTERACTION_* toggles BOTH ASR + Vision overlays (draggable vs click-through). Leave INTERACTION_HOTKEY empty unless you want a second, different combo.
ASR_INTERACTION_HOTKEY=alt+a
ASR_INTERACTION_HOTKEY_BACKUP=ctrl+alt+a
VISION_INTERACTION_HOTKEY=alt+v
VISION_INTERACTION_HOTKEY_BACKUP=ctrl+alt+v
INTERACTION_HOTKEY=
INTERACTION_HOTKEY_BACKUP=
FORCE_STEALTH_HOTKEY=alt+s
FORCE_STEALTH_HOTKEY_BACKUP=ctrl+alt+s

KNOWLEDGE_DIR=knowledge
KNOWLEDGE_PATTERNS=*.md,*.txt
KNOWLEDGE_CHUNK_CHARS=900
KNOWLEDGE_OVERLAP_CHARS=120
#
# Audio resilience / device selection
AUDIO_DEVICE_CONTAINS=
AUDIO_RECONNECT_SEC=2.0
AUDIO_WATCHDOG_SEC=2.0
#
# ASR segmentation (finalize partial after silence)
ASR_PARTIAL_SILENCE_MS=650
ASR_PUNCTUATION_FINALIZE=1
#
# Vision safety timeout
VISION_TIMEOUT_SEC=8.0