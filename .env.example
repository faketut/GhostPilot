SPEECH_KEY=your_azure_subscription_key_here
SPEECH_REGION=eastus
# Optional custom Azure Speech endpoint (use instead of region for sovereign / private clouds)
# AZURE_SPEECH_ENDPOINT=
ASR_LANGUAGE=zh-CN

# ── Answer LLM (text) ──────────────────────────────────────────────────────
# DeepSeek V4: "deepseek-flash" (V4.1-Flash) or "deepseek-v4-pro".
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here   # only if you use Gemini as the text model
TEXT_MODEL=deepseek-flash
# Force provider routing (otherwise inferred from model name)
# TEXT_PROVIDER values: openai | deepseek | gemini | ollama   (empty = auto)
TEXT_PROVIDER=
# Optional comma-separated fallback chain, e.g. deepseek,openai
TEXT_PROVIDER_FALLBACK=

# ── Screenshot OCR (local, no API key) ─────────────────────────────────────
# Ollama serves GLM-OCR locally; the recognized text is then sent to the
# text model above. Setup: ollama pull glm-ocr && python setup_glm_ocr.py
OLLAMA_BASE_URL=http://localhost:11434/v1
# Start a LOCAL Ollama at launch if it is not already answering. Ollama's own
# installer registers a Startup-folder shortcut, so after a normal login it is
# already running and this is just a probe (~1ms). It covers the cases that
# shortcut does not: Ollama was quit or crashed, its autostart was disabled, or
# GhostPilot came up before Ollama finished booting. The OCR model is preloaded
# too, so the first screenshot does not pay the ~6s model load.
# Never applies to a remote OLLAMA_BASE_URL. Set to 0 to manage the server yourself.
OLLAMA_AUTOSTART=1
OCR_MODEL=glm-ocr-optimized
# The stock "Text recognition:" prefix makes GLM-OCR run past the page and repeat
# itself until the token cap (measured: 1984 chars / 59-94 s for text it had
# already transcribed). This phrasing stops cleanly in ~12 s, same accuracy.
OCR_PROMPT=Transcribe all text in this image. Output only the text.
# Longest edge (px) the screenshot is normalised to before recognition.
# Downscaled above it (vision prefill dominates latency); upscaled below it
# (GLM-OCR misreads small text and then loops until the token cap).
OCR_MAX_DIMENSION=1024
OCR_MIN_DIMENSION=1024
# Recognition is CPU-bound; bound a single request (seconds).
# OCR_TIMEOUT_SEC is the *read* timeout (fires only on a stall);
# OCR_TOTAL_TIMEOUT_SEC is the wall-clock budget for the whole recognition.
OCR_TIMEOUT_SEC=180.0
OCR_TOTAL_TIMEOUT_SEC=120.0
# Keep the model resident between screenshots. Ollama's default is 5 minutes,
# and reloading the 2.2 GB model costs ~30 s on CPU. "30m", "-1" = forever.
OCR_KEEP_ALIVE=30m
# Cap on generated tokens (the model's own cap is 8192 ≈ 13 min per screenshot).
OCR_NUM_PREDICT=1024
# Abandon a stream that repeats the same output this many times in a row.
OCR_REPEAT_GUARD_LINES=12
# Answer generation output cap. 0 = UNCAPPED (default): the provider applies its
# own limit. A caller-set cap is a trap on reasoning models — deepseek-flash
# spends the budget on its HIDDEN chain-of-thought before writing the visible
# answer, and the two share one cap. Measured on one algorithm question: at 450
# and at 1200 the reasoning trace consumed 100% of the budget and the visible
# answer was empty; uncapped it took 1376 tokens and stopped cleanly with the
# complete code block. Set a positive value only to bound cost, and note that
# truncation is then possible no matter how large the number is.
ANSWER_MAX_TOKENS=0

# Multi-turn context
CONTEXT_TURNS=0
# Response language: auto | zh | en
RESPONSE_LANGUAGE=en
# Question-classifier knobs (non-streaming text-model call)
CLASSIFIER_MAX_TOKENS=64
CLASSIFIER_TEMPERATURE=0.1
# RAG: drop chunks with similarity below this threshold (0–1)
RAG_MIN_SCORE=0.32

SCREENSHOT_HOTKEY=alt+p
SCREENSHOT_FULL_HOTKEY=alt+shift+p
# ASR_INTERACTION_* toggles BOTH ASR + Vision overlays (draggable vs click-through). Leave INTERACTION_HOTKEY empty unless you want a second, different combo.
ASR_INTERACTION_HOTKEY=alt+a
ASR_INTERACTION_HOTKEY_BACKUP=ctrl+alt+a
VISION_INTERACTION_HOTKEY=alt+v
VISION_INTERACTION_HOTKEY_BACKUP=ctrl+alt+v
INTERACTION_HOTKEY=
INTERACTION_HOTKEY_BACKUP=
FORCE_STEALTH_HOTKEY=alt+s
FORCE_STEALTH_HOTKEY_BACKUP=ctrl+alt+s

KNOWLEDGE_DIR=knowledge
KNOWLEDGE_PATTERNS=*.md,*.txt
KNOWLEDGE_CHUNK_CHARS=900
KNOWLEDGE_OVERLAP_CHARS=120
# Algorithm turns inject a patterns cheatsheet WHOLE instead of retrieving
# (a chunk of a cheatsheet reads as a fragment, and this route must not depend
# on retrieval quality). Name is resolved under KNOWLEDGE_DIR, or absolute;
# empty disables the injection. Edits apply to the next algorithm question.
ALGORITHM_KNOWLEDGE_FILE=algorithm.md
# Safety bound: a larger cheatsheet is cut with a visible marker + a warning.
ALGORITHM_KNOWLEDGE_MAX_CHARS=8000
#
# Audio resilience / device selection
AUDIO_DEVICE_CONTAINS=
AUDIO_RECONNECT_SEC=2.0
AUDIO_WATCHDOG_SEC=2.0
#
# ASR segmentation (finalize partial after silence)
ASR_PARTIAL_SILENCE_MS=650
ASR_PUNCTUATION_FINALIZE=1
# ASR overlay: keep only the last N Q&A blocks (0 = unlimited)
ASR_OVERLAY_MAX_CONVERSATIONS=3

# ── Launch workflow: which overlay(s) to start ─────────────────────────────
# ask    = show a chooser each launch (default; no key needed)
# both   = ASR overlay + Vision overlay (audio capture + speech service run)
# vision = Vision overlay only — no audio capture, no ASR service
# asr    = ASR overlay only — no screenshot/vision overlay
# Override for a single run without editing this file: python main.py --overlay vision
STARTUP_OVERLAY_MODE=ask

# ── Background operation ───────────────────────────────────────────────────
# GhostPilot runs tray-only (no console, no taskbar button). When launched with
# python.exe it re-spawns itself under pythonw.exe and exits the console; set
# this to 1 to stay attached for debugging.
# GHOSTPILOT_NO_RELAUNCH=1
